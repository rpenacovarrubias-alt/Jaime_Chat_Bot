{
  "version": 2,
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/analyze-v2.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
